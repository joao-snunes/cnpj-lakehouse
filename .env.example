# AWS credentials (never commit real values — copy this file to .env and fill)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1

# S3 target bucket
S3_BUCKET=cnpj-lakehouse

# Source of Receita Federal files (mirror)
CORE_URL_FILES=https://arquivos.receitafederal.gov.br/dados/cnpj

# Scope: UF to keep (IBGE code prefix) and file shards to download (0..9)
UF_FILTRO=31
SHARDS_EMPRE=0,1,2
SHARDS_ESTAB=0,1,2